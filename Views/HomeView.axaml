<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CM_Simulator.ViewModels"
        xmlns:av="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        x:Name="HomeViewRoot"
        x:DataType="vm:HomeViewModel"
        mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="720"
        Width="850" Height="720"
        x:Class="CM_Simulator.Views.HomeView"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Title="ALSF-2 SLEP CM_Simulator"
        >

  <Design.DataContext>
    <vm:HomeViewModel/>
  </Design.DataContext>

  <Grid Background="{DynamicResource PrimaryBackgroundGradient}">
    <!-- Main container that switches between Home content and ICC views -->

    <!-- Home Content - visible only when on home page -->
    <Grid IsVisible="{Binding IsHomePageActive}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="1" Grid.ColumnSpan="4">
        <Grid RowDefinitions="Auto, Auto, Auto, *">
          <StackPanel Grid.Row="0" HorizontalAlignment="Center">
          <!--LVICC Cards with Navigation Arrows-->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <!-- Left Navigation Arrow -->
            <Button Content="&lt;" Command="{Binding NavigateLeftCommand}"
                    IsVisible="{Binding CanNavigateLeft}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="40" Height="50" FontSize="24" FontWeight="Bold"
                    Background="LightGray" Margin="5,0"/>
            <!-- Invisible placeholder when left arrow is hidden to maintain layout -->
            <Border Width="40" Margin="5,0" IsVisible="{Binding !CanNavigateLeft}"/>

            <!-- LVICC 1 Card (Dynamic) -->
            <HeaderedContentControl Header="{Binding VisibleLvicc1Header}" Width="200" Height="230" Margin="10" Background="White" BorderBrush="Black" BorderThickness="2">
              <Grid Margin="10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status Display -->
                <Border Grid.Row="0" Background="{Binding VisibleLvicc1Background}" CornerRadius="5" Padding="10,5" HorizontalAlignment="Center" Margin="0,5">
                  <TextBlock Text="{Binding VisibleLvicc1SideMenu}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>

                <!-- Indicators Row -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                  <!-- Remote Indicator -->
                  <Border BorderThickness="2" BorderBrush="DarkGray" CornerRadius="3" Margin="5,0" Padding="5,3">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="12" Height="12" Fill="{Binding VisibleLvicc1RemButton}" Stroke="Black" StrokeThickness="1" VerticalAlignment="Center"/>
                      <TextBlock Text="REM" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Error Indicators -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,5">
                  <TextBlock Classes="commError" Text="COMM ERROR" FontSize="11" FontWeight="Bold" Foreground="Red"
                             TextAlignment="Center" IsVisible="{Binding VisibleLvicc1CommErrorVisible}" Margin="0,2"/>
                  <TextBlock Classes="commandError" Text="SETTING ERROR" FontSize="11" FontWeight="Bold" Foreground="Red"
                             TextAlignment="Center" IsVisible="{Binding VisibleLvicc1CommandErrorVisible}" Margin="0,2"/>
                  <TextBlock Classes="modeError" Text="MODE ERROR" FontSize="11" FontWeight="Bold" Foreground="Red"
                             TextAlignment="Center" IsVisible="{Binding VisibleLvicc1ModeErrorVisible}" Margin="0,2"/>
                  <TextBlock Classes="misfireError" Text="MISFIRE ERROR" FontSize="11" FontWeight="Bold" Foreground="Red"
                             TextAlignment="Center" IsVisible="{Binding VisibleLvicc1MisfireErrorVisible}" Margin="0,2"/>
                </StackPanel>

                <!-- Navigation Button -->
                <Button Grid.Row="3" Content="Open Page" Command="{Binding GoToVisibleIcc1Command}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        IsEnabled="{Binding VisibleLvicc1ButtonEnabled}"
                        HorizontalContentAlignment="Center"
                        Width="120" Height="35" FontSize="14" Background="LightGray" Margin="0,5"/>
              </Grid>
            </HeaderedContentControl>

            <!-- LVICC 2 Card (Dynamic) -->
            <HeaderedContentControl Header="{Binding VisibleLvicc2Header}" Width="200" Height="230" Margin="10" Background="White" BorderBrush="Black" BorderThickness="2">
              <Grid Margin="10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status Display -->
                <Border Grid.Row="0" Background="{Binding VisibleLvicc2Background}" CornerRadius="5" Padding="10,5" HorizontalAlignment="Center" Margin="0,5">
                  <TextBlock Text="{Binding VisibleLvicc2SideMenu}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>

                <!-- Indicators Row -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                  <!-- Remote Indicator -->
                  <Border BorderThickness="2" BorderBrush="DarkGray" CornerRadius="3" Margin="5,0" Padding="5,3">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="12" Height="12" Fill="{Binding VisibleLvicc2RemButton}" Stroke="Black" StrokeThickness="1" VerticalAlignment="Center"/>
                      <TextBlock Text="REM" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Error Indicators -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,5">
                  <TextBlock Classes="commError" Text="COMM ERROR" FontSize="11" FontWeight="Bold" Foreground="Red"
                             TextAlignment="Center" IsVisible="{Binding VisibleLvicc2CommErrorVisible}" Margin="0,2"/>
                  <TextBlock Classes="commandError" Text="SETTING ERROR" FontSize="11" FontWeight="Bold" Foreground="Red"
                             TextAlignment="Center" IsVisible="{Binding VisibleLvicc2CommandErrorVisible}" Margin="0,2"/>
                  <TextBlock Classes="modeError" Text="MODE ERROR" FontSize="11" FontWeight="Bold" Foreground="Red"
                             TextAlignment="Center" IsVisible="{Binding VisibleLvicc2ModeErrorVisible}" Margin="0,2"/>
                  <TextBlock Classes="misfireError" Text="MISFIRE ERROR" FontSize="11" FontWeight="Bold" Foreground="Red"
                             TextAlignment="Center" IsVisible="{Binding VisibleLvicc2MisfireErrorVisible}" Margin="0,2"/>
                </StackPanel>

                <!-- Navigation Button -->
                <Button Grid.Row="3" Content="Open Page" Command="{Binding GoToVisibleIcc2Command}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        IsEnabled="{Binding VisibleLvicc2ButtonEnabled}"
                        HorizontalContentAlignment="Center"
                        Width="120" Height="35" FontSize="14" Background="LightGray" Margin="0,5"/>
              </Grid>
            </HeaderedContentControl>

            <!-- LVICC 3 Card (Dynamic) -->
            <HeaderedContentControl Header="{Binding VisibleLvicc3Header}" Width="200" Height="230" Margin="10" Background="White" BorderBrush="Black" BorderThickness="2">
              <Grid Margin="10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status Display -->
                <Border Grid.Row="0" Background="{Binding VisibleLvicc3Background}" CornerRadius="5" Padding="10,5" HorizontalAlignment="Center" Margin="0,5">
                  <TextBlock Text="{Binding VisibleLvicc3SideMenu}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>

                <!-- Indicators Row -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                  <!-- Remote Indicator -->
                  <Border BorderThickness="2" BorderBrush="DarkGray" CornerRadius="3" Margin="5,0" Padding="5,3">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="12" Height="12" Fill="{Binding VisibleLvicc3RemButton}" Stroke="Black" StrokeThickness="1" VerticalAlignment="Center"/>
                      <TextBlock Text="REM" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Error Indicators -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,5">
                  <TextBlock Classes="commError" Text="COMM ERROR" FontSize="11" FontWeight="Bold" Foreground="Red"
                             TextAlignment="Center" IsVisible="{Binding VisibleLvicc3CommErrorVisible}" Margin="0,2"/>
                  <TextBlock Classes="commandError" Text="SETTING ERROR" FontSize="11" FontWeight="Bold" Foreground="Red"
                             TextAlignment="Center" IsVisible="{Binding VisibleLvicc3CommandErrorVisible}" Margin="0,2"/>
                  <TextBlock Classes="modeError" Text="MODE ERROR" FontSize="11" FontWeight="Bold" Foreground="Red"
                             TextAlignment="Center" IsVisible="{Binding VisibleLvicc3ModeErrorVisible}" Margin="0,2"/>
                  <TextBlock Classes="misfireError" Text="MISFIRE ERROR" FontSize="11" FontWeight="Bold" Foreground="Red"
                             TextAlignment="Center" IsVisible="{Binding VisibleLvicc3MisfireErrorVisible}" Margin="0,2"/>
                </StackPanel>

                <!-- Navigation Button -->
                <Button Grid.Row="3" Content="Open Page" Command="{Binding GoToVisibleIcc3Command}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        IsEnabled="{Binding VisibleLvicc3ButtonEnabled}"
                        HorizontalContentAlignment="Center"
                        Width="120" Height="35" FontSize="14" Background="LightGray" Margin="0,5"/>
              </Grid>
            </HeaderedContentControl>

            <!-- Right Navigation Arrow -->
            <Button Content="&gt;" Command="{Binding NavigateRightCommand}"
                    IsVisible="{Binding CanNavigateRight}"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Width="40" Height="50" FontSize="24" FontWeight="Bold"
                    Background="LightGray" Margin="5,0"/>
            <!-- Invisible placeholder when right arrow is hidden to maintain layout -->
            <Border Width="40" Margin="5,0" IsVisible="{Binding !CanNavigateRight}"/>
          </StackPanel>
        </StackPanel>
        
        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
          <HeaderedContentControl Header="CM Control" Height="100" Margin="10" HorizontalAlignment="Center" Background="White">
            <StackPanel Orientation="Horizontal">
              <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Button IsEnabled="{Binding CmOffEnabled}" Content="OFF" FontSize="16" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="60" Height="50" Foreground="{Binding OffForeground}" Background="{Binding OffButton}" Command="{Binding MainOffControlClicked}"/>
              </Border>
              <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Button IsEnabled="{Binding CmOnEnabled}" Content="ON" FontSize="16" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="60" Height="50" Foreground="{Binding OnForeground}" Background="{Binding OnButton}" Command="{Binding MainOnControlClicked}"/>
              </Border>
              <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Button IsEnabled="{Binding CmLowEnabled}" Content="LOW" FontSize="16" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="60" Height="50" Foreground="{Binding LowForeground}" Background="{Binding LowButton}" Command="{Binding MainLowControlClicked}"/>
              </Border>
              <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Button IsEnabled="{Binding CmMedEnabled}" Content="MED" FontSize="16" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="60" Height="50" Foreground="{Binding MedForeground}" Background="{Binding MedButton}" Command="{Binding MainMedControlClicked}"/>
              </Border>
              <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Button IsEnabled="{Binding CmHighEnabled}" Content="HI" FontSize="16" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="60" Height="50" Foreground="{Binding HighForeground}" Background="{Binding HighButton}" Command="{Binding MainHighControlClicked}"/>
              </Border>
              <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Button IsEnabled="{Binding CmAlsfEnabled}" Content="ALSF" FontSize="16" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="70" Height="50" Background="{Binding AlsfButton}" Command="{Binding AlsfModeChangeCommand}"/>
              </Border>
              <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Button IsEnabled="{Binding CmSsalrEnabled}" Content="SSALR" FontSize="16" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="70" Height="50" Background="{Binding SsalrButton}" Command="{Binding SsalrModeChangeCommand}"/>
              </Border>
            </StackPanel>
          </HeaderedContentControl>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="30,0,0,0">
          <HeaderedContentControl Header="COMMANDS" Height="100" Margin="10" HorizontalAlignment="Center" Background="White">
            <StackPanel Orientation="Horizontal">
              <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Button IsEnabled="{Binding ResetEnabled}" x:Name="resetRequestBtn" Content="Reset" FontSize="16" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="60" Height="50" Background="LightGray" Command="{Binding ResetResultRequested}"/>
              </Border>
              <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Button IsEnabled="{Binding ShortEnabled}" x:Name="shortDataBtn" Content="Short" FontSize="16" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="60" Height="50" Background="{Binding ShortButton}" Command="{Binding ShortDataRequested}"/>
              </Border>
              <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Button IsEnabled="{Binding ConfigEnabled}" x:Name="configRequestBtn" Content="Config" FontSize="16" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="70" Height="50" Background="{Binding ConfigButton}" Command="{Binding ConfigDataRequested}"/>
              </Border>
            </StackPanel>
          </HeaderedContentControl>
          <HeaderedContentControl Header="STATUS" Height="100" Margin="50,0" HorizontalAlignment="Center" Background="White">
            <StackPanel Orientation="Horizontal">
              <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Grid Width="80" Height="50">
                  <Rectangle Width="80" Height="50" Fill="{Binding Caution}" />
                  <TextBlock Text="CAUTION" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{Binding CautionForeground}"/>
                </Grid>
              </Border>
                <!--
              <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Button Width="70" Height="50" Background="{Binding CommFault}" Command="{Binding CommFaultClickedCommand}">
                    <Grid Width="70" Height="50">
                        <TextBlock Text="COMM FAULT" FontSize="16" TextWrapping="Wrap" Foreground="{Binding CommFaultForeground}" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Button>
              </Border>
              -->
            <Border BorderThickness="5" BorderBrush="DarkGray" Margin="5,0" Height="60">
                <Button Width="80" Height="50" Background="{Binding Failure}" Command="{Binding FailureClickedCommand}">
                    <Grid Width="80" Height="50">
                        <TextBlock Text="FAILURE" FontSize="16" TextWrapping="Wrap" Foreground="{Binding FailureForeground}" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </Button>
              </Border>
            </StackPanel>
          </HeaderedContentControl>
        </StackPanel>
          
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
          <!-- Use a Button that contains your Image (SVG). The Flyout is attached to the Button -->
          <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Right" Name="MenuButton">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <StackPanel Background="White" Width="180">
                  <!-- NOTE: no CommandParameter bindings here -->
                  <!--  <Button Content="Scan ICCs"
                            FontSize="16"
                            Background="Transparent"
                            HorizontalAlignment="Left"
                            Padding="10,8"
                            Click="Scan_Click"/> -->
                  <Button Content="Change Port"
                          FontSize="16"
                          Background="Transparent"
                          HorizontalContentAlignment="Left"
                          Padding="10,8"
                          Click="ChangePort_Click"/>
                  <Button Content="Export Log"
                          FontSize="16"
                          Background="Transparent"
                          HorizontalContentAlignment="Left"
                          Padding="10,8"
                          Click="ExportLog_Click"/>
                </StackPanel>
              </Flyout>
            </Button.Flyout>

            <!-- Your SVG Image inside the button (same pattern you used earlier) -->
            <Image Source="{SvgImage /Assets/Images/list.svg}"
                   Width="37"
                   Height="37"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
			<StackPanel Orientation="Horizontal" Margin="0,0,10,0">
				<Ellipse Width="30" Height="30" Stroke="Black" StrokeThickness="2" Fill="{Binding TxStatus}" Margin="10,0"/>
                <TextBlock Text="TX" VerticalAlignment="Center" FontSize="16" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,10,20">
				<Ellipse Width="30" Height="30" Stroke="Black" StrokeThickness="2" Fill="{Binding RxStatus}" Margin="10,0"/>
                <TextBlock Text="RX" VerticalAlignment="Center" FontSize="16" />
            </StackPanel>
        </StackPanel>

        
        <TextBox x:Name="LogTextBox" Text="{Binding LogText, Mode=OneWay}" Grid.Row="4" Background="White" Margin="10,0,5,10" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" av:ScrollViewer.VerticalScrollBarVisibility="Auto" ></TextBox>
        </Grid>
      </Border>
    </Grid>

    <!-- ICC View Content - visible when NOT on home page -->
    <Grid IsVisible="{Binding !IsHomePageActive}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Back to Home Button -->
      <Button Grid.Row="0" Content="&lt;" Command="{Binding GoToHomeCommand}"
              HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              Width="50" Height="35" FontSize="14" Background="LightGray" Margin="20,15"/>

      <!-- ICC View Container - displays the current ICC page -->
      <ContentControl Grid.Row="1" Content="{Binding CurrentIccPage}" Margin="0,-40,0,0"/>
    </Grid>

  </Grid>
</Window>